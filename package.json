{
	"name": "joq.dev",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Astro and React starter for joq.dev, deployed as a static Cloudflare Pages site and backed by Sanity CMS.",
	"packageManager": "npm@11.12.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
		"build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
		"preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc -p tsconfig.test.json --pretty false",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"ci": "biome ci .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"overrides": {
		"vite": "^7.2.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/react": "^5.0.5",
		"@biomejs/biome": "^2.4.15",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.3.2",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.4",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	}
}
